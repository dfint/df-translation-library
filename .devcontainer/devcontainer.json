{
  "name": "Zig 0.17",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers-extra/features/zig:1": {
      "version": "0.17.0"
    }
  },
  "postCreateCommand": "sudo bash .devcontainer/install-zlint.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ziglang.vscode-zig",
        "ianic.zig-language-extras"
      ]
    }
  }
}